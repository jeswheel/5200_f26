\section{Applied Examples in R}

\begin{frame}[fragile, allowframebreaks]{Example 1: Significant Interaction (ToothGrowth)}
  \begin{itemize}
    \item The built-in \texttt{ToothGrowth} dataset measures tooth length (\texttt{len}) in guinea pigs under two factors:
    \begin{itemize}
      \item \textbf{Supplement (\texttt{supp}):} Orange Juice (OJ) or Ascorbic Acid (VC).
      \item \textbf{Dose (\texttt{dose}):} 0.5, 1.0, or 2.0 mg/day.
    \end{itemize}
    \item First, we must convert \texttt{dose} from a numeric variable into a factor so R treats it as categorical.
  \end{itemize}

<<tooth_setup, size='small', eval=TRUE, echo=TRUE>>=
# Load data and convert dose to a factor
data(ToothGrowth)
ToothGrowth$dose <- as.factor(ToothGrowth$dose)
@

  \framebreak

  \begin{block}{Visualizing the Interaction}
    We start with an interaction plot. Crossing or converging lines suggest an interaction effect.
  \end{block}

<<tooth_plot, fig.height=4, fig.width=6, fig.align='center', eval=TRUE, echo=TRUE>>=
interaction.plot(
  x.factor = ToothGrowth$dose, 
  trace.factor = ToothGrowth$supp, 
  response = ToothGrowth$len,
  type = "b", pch = c(16, 17), 
  col = c("orange", "blue"),
  xlab = "Dose (mg/day)", 
  ylab = "Mean Tooth Length",
  trace.label = "Supplement"
)
@

  \framebreak

  \begin{block}{Fitting the Model and Testing (Top-Down Rule)}
    We fit the full model with the \texttt{*} operator and check the ANOVA table.
  \end{block}

<<tooth_aov, size='small', eval=TRUE, echo=TRUE>>=
mod_tooth <- aov(len ~ supp * dose, data = ToothGrowth)
summary(mod_tooth)
@

  \begin{itemize}
    \item \textbf{Interpretation:} The \texttt{supp:dose} interaction is significant ($p = 0.02$). Following our Top-Down Rule, we \textbf{stop} and do not interpret the main effects blindly. The effect of the supplement depends entirely on the dose.
  \end{itemize}

  \framebreak

  \begin{block}{Analyzing Simple Effects with \texttt{emmeans}}
    Because the interaction is significant, we should look at the \alert{simple effects} -- pairwise differences that vary just a single factor.
    In this case, the effect of the supplement \emph{at each specific level} of the dose.
  \end{block}

<<tooth_posthoc, size='small', eval=TRUE, echo=TRUE>>=
library(emmeans)
# The "|" operator tells emmeans to compare 'supp' AT each level of 'dose'
emm_tooth <- emmeans(mod_tooth, ~ supp | dose)
pairs(emm_tooth)
@

  \begin{itemize}
    \item \textbf{Conclusion:} Orange juice (OJ) results in significantly longer teeth at doses of 0.5 and 1.0, but there is no significant difference between supplements at a dose of 2.0.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Demystifying the \texttt{emmeans} Syntax}
  \begin{itemize}
    \item In a one-way ANOVA, we could use \texttt{emmeans(model, \textasciitilde{} Factor)} to get the estimated means for each group.
    \item In a two-way ANOVA with a significant interaction, we must examine \alert{simple main effects}. We need to know the effect of one factor \emph{at specific levels} of the other factor.
  \end{itemize}

  \begin{block}{Breaking down: \texttt{\textasciitilde{} supp | dose}}
    \begin{itemize}
      \item \textbf{\texttt{\textasciitilde{} supp}}: This tells R to calculate the differences between the levels of the Supplement factor (OJ vs. VC).
      \item \textbf{\texttt{|} (The Pipe/Bar)}: In R formulas, the vertical bar means "given" or "conditioned on." 
      \item \textbf{\texttt{dose}}: This is the grouping variable. It tells R to split the analysis up by the levels of Dose.
    \end{itemize}
  \end{block}

  \begin{itemize}
    \item \textbf{Plain English Translation:} "Compare the mean tooth length of OJ vs. VC, and do this comparison three separate times: once for the 0.5 dose, once for the 1.0 dose, and once for the 2.0 dose."
  \end{itemize}
\end{frame}

\begin{frame}[fragile, allowframebreaks]{Example 2: No Interaction (Additive Model)}
  \begin{itemize}
    \item The built-in \texttt{npk} dataset records pea yields based on applying Nitrogen (\texttt{N}) and Phosphate (\texttt{P}). 
    \item Let's evaluate if Nitrogen and Phosphate interact to affect \texttt{yield}.
  \end{itemize}

<<npk_data>>=
NP <- read.csv('NP.csv')
str(NP)
@

  \framebreak

<<npk_aov, size='small', eval=TRUE, echo=TRUE>>=
mod_NP <- aov(yield ~ N * P, data = NP)
summary(mod_NP)
@

  \begin{itemize}
    \item \textbf{Interpretation:} The \texttt{N:P} interaction is not significant ($P = 0.4305$). That is, there is not strong evidence in the data that the effect of Nitrogen inclusions on Mean Yield depends on the inclusion of Phosphate.
    \item We can examine this further with the interaction plot
  \end{itemize}

<<echo=TRUE>>=
# Visualize the data
interaction.plot(
  x.factor = NP$N, 
  trace.factor = NP$P, 
  response = NP$yield,
  type = "b", pch = c(16, 17),
  col = c("darkgreen", "brown"),
  xlab = "Nitrogen (N)", ylab = "Mean Yield",
  trace.label = "Phosphate (P)"
)
@


  \framebreak
  
  \begin{itemize}
    \item Not significant interaction. Now what?
    \begin{itemize}
      \item Historically, we might want to re-fit an \alert{additive model} to conserve degrees of freedom. \mode<article>{Doing so allows us to pool degrees of freedom from the interaction term, leading to higher statistical power to detect main effects.} \textbf{Problem:} This is called \emph{post-selection inference}, and can mean we have inflated type-I error rates.
      
      \mode<presentation>{\vspace{2cm}}
      \mode<article>{The reason why is because we are doing some type of ``double dipping". We should not use the data to decide \emph{which} hypothesis to test, and then use that exact same data to test the hypothesis. Doing so leads to additional Type-I errors.}
      
      \item Current practice: we are more concerned about the increased Type-I error rate than we are of improving statistical power. We will interpret P-values in the context of accounting for interactions, even if they are non-significant. 
    \end{itemize}
  \end{itemize}

\framebreak

  \begin{block}{(Historic approach): Fitting the Additive Model}
    We use the \texttt{+} operator to fit a model assuming the effects of N and P are strictly independent.
  \end{block}

<<npk_additive, size='small', eval=TRUE, echo=TRUE>>=
# Fit additive model (no interaction)
mod_NP_add <- aov(yield ~ N + P, data = NP)
summary(mod_NP_add)
@

  \begin{itemize}
    \item \textbf{Conclusion:} Nitrogen (\texttt{N}) has a significant main effect on yield ($p = 0.0247$), while Phosphate (\texttt{P}) does not ($p = 0.6155$).
    Because the model is additive, we conclude Nitrogen increases yield regardless of whether Phosphate is applied or not.
    \item We could continue to extract treatment group means and treatment effects using the \texttt{emmeans} package as needed (see below).
  \end{itemize}
\end{frame}

\begin{frame}[fragile, allowframebreaks]{Extracting Treatment Means and Effects}
  \begin{itemize}
    \item Following modern practice, we retain the full model (\texttt{mod\_NP}) even though the interaction was not significant.
    \item We can use \texttt{emmeans} to extract the estimated marginal means (treatment means) for Nitrogen, averaging over the levels of Phosphate.
  \end{itemize}

<<NP_means, size='small', eval=TRUE, echo=TRUE>>=
library(emmeans)

# Extract Estimated Marginal Means for Nitrogen (N)
# mod_NP is FULL model, not additive
emm_N <- emmeans(mod_NP, ~ N)
emm_N
@

  \framebreak

  \begin{block}{Calculating the Treatment Effect}
    To find the actual size of the treatment effect (the difference between adding Nitrogen vs. not adding Nitrogen), we pass our means into the \texttt{pairs()} function.
  \end{block}

<<NP_effects, size='small', eval=TRUE, echo=TRUE>>=
# Test the pairwise difference (Treatment Effect)
pairs(emm_N)
@

  \begin{itemize}
    \item \textbf{Interpretation:} The estimated mean yield without Nitrogen is 52.1, and with Nitrogen is 57.7. The \texttt{pairs()} output shows that applying Nitrogen increases the mean yield by an estimated 5.62 units, and this main effect is statistically significant.
  \end{itemize}
\end{frame}

\section{Factorial Contrasts}

\begin{frame}[fragile,allowframebreaks]{Contrasts in Factorial Designs}
  \begin{itemize}
    \item Contrasts in a factorial design operate exactly the same way as in a one-way ANOVA. We are simply picking weights to compare means.
    \item Depending on our research question, we apply these contrasts to two different types of means:
    \begin{enumerate}
      \item \alert{Main Effect Contrasts:} We compare the \textbf{marginal means} of one factor (averaging over the levels of the other factor).
      \item \alert{Cell / Simple Effect Contrasts:} We compare the specific \textbf{treatment combination means} ($\mu_{ij}$).
    \end{enumerate}
    \item While possible, we do not need to build complex weight matrices by hand. We use software to apply standard adjustments (like Tukey HSD) directly to the means we care about.
  \end{itemize}

  \framebreak

  \begin{block}{Main Effect Contrasts (No Interaction)}
    If there is no significant interaction, we want to know which levels of Factor A differ from each other overall.
    We extract the marginal means and apply a Tukey adjustment.
  \end{block}

  
\framebreak

<<contrast_main, size='small', eval=FALSE, echo=TRUE>>=
library(emmeans)

# Fit a Three-Way ANOVA
mod <- aov(response ~ Factor_A*Factor_B*Factor_C, data = DATA)

# Extract marginal means for Factor A
emm_A <- emmeans(mod, ~ Factor_A)

# Perform all pairwise comparisons with Tukey adjustment
pairs(emm_A, adjust = "tukey")
@

  \framebreak

  \begin{block}{Cell Means \& Simple Effect Contrasts (Interaction Present)}
    If an interaction is present, marginal means are misleading. We must compare the specific combinations (cells), or compare the levels of Factor A strictly within a single level of Factor B.
  \end{block}

<<contrast_interaction, size='small', eval=FALSE, echo=TRUE>>=
# Extract the means for every specific treatment combination
emm_cells <- emmeans(mod, ~ Factor_A * Factor_B)

# Compare Factor A ONLY within specific levels of Factor B
# (This tests the simple main effects)
contrast(emm_cells, method = "pairwise", by = "Factor_B")

# Alternative: Compare all cells against a specific Control cell 
# using Dunnett's adjustment
contrast(emm_cells, method = "trt.vs.ctrl", ref = 1)
@

\end{frame}

\section{Advanced Topics in Factorials}

\subsection{Unbalanced Factorials}

\begin{frame}[allowframebreaks]{Types of Sums of Squares (3-Way Factorial)}
  \begin{itemize}
    \item When cell sizes are unequal ($n_{ijk} \neq n$), factors lose orthogonality.
    \item The choice of \alert{Sums of Squares (SS)} dictates which model terms are held constant in the reduced vs. full model comparison ($SS_{\text{Effect}} = SS_{\text{Error, reduced}} - SS_{\text{Error, full}}$).
  \end{itemize}

  \begin{table}
  \centering
  \scriptsize
  \begin{tabular}{l l l l}
    \hline
    \textbf{Effect} & \textbf{Type I (Sequential)} & \textbf{Type II (Hierarchical)} & \textbf{Type III (Marginal)} \\
    \hline
    $A$ & $SS(A)$ & $SS(A \mid B, C)$ & $SS(A \mid B, C, AB, AC, BC, ABC)$ \\
    $B$ & $SS(B \mid A)$ & $SS(B \mid A, C)$ & $SS(B \mid A, C, AB, AC, BC, ABC)$ \\
    $C$ & $SS(C \mid A, B)$ & $SS(C \mid A, B)$ & $SS(C \mid A, B, AB, AC, BC, ABC)$ \\
    $AB$ & $SS(AB \mid A, B, C)$ & $SS(AB \mid A, B, C, AC, BC)$ & $SS(AB \mid A, B, C, AC, BC, ABC)$ \\
    $AC$ & $SS(AC \mid A, B, C, AB)$ & $SS(AC \mid A, B, C, AB, BC)$ & $SS(AC \mid A, B, C, AB, BC, ABC)$ \\
    $BC$ & $SS(BC \mid A, B, C, AB, AC)$ & $SS(BC \mid A, B, C, AB, AC)$ & $SS(BC \mid A, B, C, AB, AC, ABC)$ \\
    $ABC$ & $SS(ABC \mid A, B, C, AB, AC, BC)$ & $SS(ABC \mid A, B, C, AB, AC, BC)$ & $SS(ABC \mid A, B, C, AB, AC, BC)$ \\
    \hline
  \end{tabular}
  \caption{Comparison of Sums of Squares conditional notation for factors A, B, and C.}
  \end{table}

  \framebreak

  \begin{block}{Which Type Should You Use in Practice?}
    \begin{itemize}
      \item \textbf{Type I:} Avoid unless testing a strict hierarchical sequence (e.g., covariate first). Order of terms in \texttt{aov()} changes the output!
      \item \textbf{Type II:} Best default when you are confident higher-order interactions are zero ($AB = 0$). Maximizes statistical power.
      \item \textbf{Type III:} Standard for factorial experiments. Tests equal weighting across all treatment cells regardless of sample size differences.
    \end{itemize}
  \end{block}
\end{frame}

\begin{frame}[fragile, allowframebreaks]{Unbalanced Data: Practical Workflow in R}
  \begin{itemize}
    \item Base R's \texttt{summary(aov())} defaults to Type I SS, making it dangerous for unbalanced data.
    \item \textbf{Solution:} Use \texttt{joint\_tests()} from \texttt{emmeans}. It provides Type III hypothesis tests safely without requiring you to change R's global options.
  \end{itemize}

<<unbalanced_workflow, size='small', eval=FALSE>>=
library(emmeans)

# Fit standard model on unbalanced data
mod_unbal <- aov(yield ~ P * K, data = unbalanced_data)

# 1. Run Type III ANOVA tests safely
joint_tests(mod_unbal)
@

  \framebreak

  \begin{block}{Practical Decision Rules}
    \begin{enumerate}
      \item \textbf{Look at the Interaction p-value first:}
      \begin{itemize}
        \item If $p \ge 0.05$ (No interaction): Interpret overall main effects and run overall pairwise comparisons: \texttt{emmeans(mod, ~ P)}.
        \item If $p < 0.05$ (Interaction present): \alert{Stop!} Do not interpret global main effects. You must analyze \textbf{Simple Main Effects}.
      \end{itemize}
    \end{enumerate}
  \end{block}
\end{frame}

\begin{frame}[fragile, allowframebreaks]{Analyzing Simple Main Effects}
  \begin{itemize}
    \item \alert{Definition:} A \textbf{simple main effect} tests the effect of Factor A at *one specific fixed level* of Factor B.
    \item When an interaction exists, stating "Superphosphate increases yield" is incomplete. You must state "Superphosphate increases yield *when Potash is absent*, but has no effect *when Potash is present*."
    \item Use the \texttt{by} argument in \texttt{emmeans} to slice the analysis.
  \end{itemize}

<<simple_effects_code, size='small', eval=FALSE>>=
# Obtain EMMs for the interaction
emm_int <- emmeans(mod_unbal, ~ P * K)

# Test the simple main effect of Potash (K) WITHIN each level of Superphosphate (P)
contrast(emm_int, method = "pairwise", by = "P")

# Plot simple effects visually
emmip(mod_unbal, K ~ P)
@

\end{frame}
\section{Multiple Comparisons: Beyond the F-Test}

\begin{frame}[fragile, allowframebreaks]{Multiple Comparisons in Practice}
  \begin{itemize}
    \item A significant ANOVA interaction tells you \emph{some} difference exists, but testing all pairs blindly increases your \alert{family-wise error rate} (false positive rate).
    \item The \texttt{emmeans} package provides a streamlined pipeline for post-hoc testing with appropriate data-dredging penalties.
  \end{itemize}

<<mult_comp, size='small', eval=FALSE>>=
# Assuming fert_mod is our fitted two-way model
emm_int <- emmeans(fert_mod, ~ P * K)

# Tukey adjustment for all pairwise comparisons
pairs(emm_int, adjust = "tukey")
@

  \framebreak

  \begin{block}{Visualizing Contrasts}
    \begin{itemize}
      \item Staring at massive tables of p-values makes it difficult to assess effect sizes.
      \item You can pass your contrast object directly into a plot to visually see which adjusted confidence intervals exclude zero.
    \end{itemize}
  \end{block}

<<mult_comp_plot, size='small', eval=FALSE, fig.height=4, fig.align='center'>>=
# Generates a forest plot of the differences between groups
plot(pairs(emm_int, adjust = "tukey")) + 
  ggplot2::geom_vline(xintercept = 0, linetype = "dashed", color = "red") +
  ggplot2::labs(title = "Tukey-Adjusted Pairwise Differences")
@

\end{frame}

\section{Resource Constraints: Unreplicated \& Fractional Designs}

\begin{frame}[fragile, allowframebreaks]{Unreplicated Factorials ($n=1$)}
  \begin{itemize}
    \item Experiments are expensive. Sometimes we can only afford a single replicate per treatment combination ($n=1$).
    \item \alert{The Problem:} Fitting a full factorial model uses up all available degrees of freedom. The error degrees of freedom ($df_E$) becomes 0, so R returns \texttt{NA} for all standard errors and p-values.
  \end{itemize}

<<unrep_problem, size='small', eval=FALSE>>=
# Fits main effects, 2-way, 3-way, and 4-way interactions
mod_unrep <- aov(yield ~ A * B * C * D, data = unrep_data)

# F-values and p-values will return as NA
summary(mod_unrep) 
@

  \framebreak

  \begin{block}{The Fix: Pooling into Error}
    \begin{itemize}
      \item Relying on the \alert{Sparsity of Effects Principle}, we assume high-order interactions (e.g., 3-way and 4-way) are effectively zero (just random noise).
      \item We restrict the model, pushing those negligible higher-order terms into the residual error to mathematically generate degrees of freedom.
    \end{itemize}
  \end{block}

<<unrep_fix, size='small', eval=FALSE>>=
# Restrict the model to main effects and 2-way interactions only
# The "^2" syntax drops 3-way and 4-way terms into the error
mod_pooled <- aov(yield ~ (A + B + C + D)^2, data = unrep_data)

# Now R can calculate p-values for main and 2-way effects!
summary(mod_pooled) 
@

\end{frame}

\begin{frame}[fragile, allowframebreaks]{Fractional Factorials \& Confounding}
 \begin{itemize}
    \item A \alert{fractional factorial} design runs only a structured fraction of the full combinations (e.g., 16 runs instead of 32 for a 5-factor design).
    \item \textbf{How R handles it:} R automatically recognizes the missing runs and returns \texttt{NA} for the interaction terms it cannot mathematically estimate.
    \item \textbf{Aliasing:} Because we skipped runs, certain effects are perfectly correlated (confounded). 
    \begin{itemize}
        \item \emph{Intuition:} If we design a half-fraction by defining Factor C's levels mathematically as $A \times B$, R cannot tell if an observed change in yield is caused by the main effect of C, or the interaction of A and B.
    \end{itemize}
  \end{itemize}

<<fractional_alias, size='small', eval=TRUE>>=
# Generate a mock half-fraction dataset (2^(3-1))
library(FrF2)
frac_data <- FrF2(nruns = 4, nfactors = 3, factor.names = c("A", "B", "C"))
frac_data$yield <- c(14, 18, 22, 19)

frac_mod <- aov(yield ~ A * B * C, data = frac_data)

# This outputs the exact matrix showing which main effects 
# are mathematically identical to which interaction terms:
alias(frac_mod)
@
  \framebreak

  \begin{block}{Visual Diagnostics: Daniel Plots}
    \begin{itemize}
      \item If you have zero degrees of freedom for error (saturated/fractional models), you can evaluate effects visually without an F-test using a \alert{Half-Normal Probability Plot}.
      \item \textbf{Interpretation:} Noise falls along a straight line. Significant, active effects break away from the line.
    \end{itemize}
  \end{block}

<<daniel_plot, size='small', eval=FALSE, fig.height=4, fig.align='center'>>=
library(FrF2)

# Visually identify active effects in an unreplicated or 
# fractional design without needing an error term
DanielPlot(frac_mod, half = TRUE, 
           main = "Half-Normal Plot of Effects")
@

\end{frame}

